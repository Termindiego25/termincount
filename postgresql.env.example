# The database name, username, and password are read from Docker Secrets.
# Docker env files use KEY=value lines, not YAML KEY: value entries.
POSTGRES_DB_FILE=/run/secrets/db_database
POSTGRES_USER_FILE=/run/secrets/db_username
POSTGRES_PASSWORD_FILE=/run/secrets/db_password

# Optional PostgreSQL initialization settings.
# POSTGRES_INITDB_ARGS=--encoding=UTF8 --locale=C
