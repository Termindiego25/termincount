{
  "name": "termincount",
  "version": "1.3.1",
  "private": true,
  "description": "Shareable live vote counter web app built with SvelteKit and PostgreSQL.",
  "author": "Termindiego25",
  "license": "GPL-3.0",
  "packageManager": "npm@11.21.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "homepage": "https://termincount.diegosr.es",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Termindiego25/termincount.git"
  },
  "bugs": {
    "url": "https://github.com/Termindiego25/termincount/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "vite dev --host 127.0.0.1",
    "build": "vite build",
    "preview": "node build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "npm run check && node tools/smoke-test.mjs",
    "test:e2e": "playwright test",
    "release": "node tools/release.mjs"
  },
  "dependencies": {
    "bootstrap": "5.3.8",
    "pg": "8.23.1",
    "qrcode": "1.5.4"
  },
  "overrides": {
    "cookie": "1.1.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@sveltejs/adapter-node": "6.0.0",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "svelte": "5.57.2",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "8.3.4"
  }
}
